        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(auth_account_lockouts_total{namespace=\"healthcare\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
